# Supabase 연결 문자열 (Connect → Transaction pooler, 포트 6543)
DATABASE_URL=postgresql://postgres.[프로젝트ID]:[DB비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 상담원 모드·관리 화면 PIN (숫자 4~12자리, 인터넷 공개 시 6자리 이상 권장)
STAFF_PIN=246810
# 로그인 토큰 서명용 비밀값. 아래 명령으로 만든 긴 문자열을 넣는다
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# 로컬 실행 포트 (Vercel에서는 쓰지 않음)
PORT=3000
